APP_NAME=AI Workspace API
APP_VERSION=1.0.0
APP_ENV=production

HOST=0.0.0.0
PORT=8000

SECRET_KEY=your-production-jwt-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=300

# AWS RDS PostgreSQL connection string
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<AWS_RDS_ENDPOINT>:5432/<DB_NAME>

# AWS S3 Storage credentials
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-s3-bucket-name

# Production Frontend URL (AWS Amplify or custom domain)
FRONTEND_URL=https://main.d123456789.amplifyapp.com
CORS_ORIGINS=https://main.d123456789.amplifyapp.com,https://yourdomain.com

ADMIN_EMAIL=admin@company.com

# AI API Keys
OPENAI_API_KEY=your-openai-api-key
TAVILY_API_KEY=your-tavily-api-key
GEMINI_API_KEY=your-gemini-api-key
